<UserControl x:Class="KairosoftGameToolbox.Views.GameDetailsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="SectionCard" TargetType="Border">
   <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
   <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="CornerRadius" Value="16" />
   <Setter Property="Padding" Value="24" />
  </Style>
 </UserControl.Resources>
 <Grid>
 <ScrollViewer x:Name="DetailsScroll" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
  <StackPanel x:Name="PageBody" Margin="28,8,28,28" Spacing="18" MaxWidth="1050" HorizontalAlignment="Stretch">
   <Button x:Name="BackButton" Click="Back_Click" Style="{StaticResource SubtleButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Back"/><TextBlock Text="返回游戏库"/></StackPanel></Button>
   <Border Style="{StaticResource SectionCard}">
    <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border CornerRadius="10" Background="{ThemeResource CoverGradientBrush}" Height="180"><Image x:Name="Cover" Stretch="UniformToFill"/></Border>
     <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
      <TextBlock Text="MOD 与存档修改" FontSize="12" Foreground="{ThemeResource AccentBrush}"/>
      <TextBlock x:Name="GameTitle" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="GameStatus" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"/>
      <Button x:Name="LaunchButton" Content="启动游戏" Style="{StaticResource AccentButtonStyle}" Click="Launch_Click"/>
     </StackPanel>

    </Grid>
   </Border>
   <Border Style="{StaticResource SectionCard}">
    <StackPanel Spacing="12">
     <TextBlock Text="01  ·  游戏目录" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="Steam 安装目录会自动填入。非 Steam 版本请选择直接包含 KairoGames.exe 的文件夹。" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}"/>
     <TextBlock x:Name="TargetText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
     <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="选择非 Steam 游戏目录" Click="Folder_Click"/><Button x:Name="SteamButton" Content="使用 Steam 目录" Click="Steam_Click"/></StackPanel>
    </StackPanel>
   </Border>
   <Border x:Name="ModSection" Style="{StaticResource SectionCard}">
    <StackPanel Spacing="12">
     <TextBlock Text="02  ·  模组文件" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="模组独立于启动器发布。选择 ZIP 后自动归档；释放前校验游戏及版本，不支持的目标不会写入。" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}"/>
     <Button Content="下载最新 Mod 并选择 · 尚未开放" IsEnabled="False"/>
     <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="选择本地 Mod ZIP" Click="Package_Click"/></StackPanel>
     <TextBlock x:Name="PackageText" Text="尚未选择模组" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
     <TextBlock x:Name="PackageDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}"/>
     <Button x:Name="InstallButton" Content="校验并释放 Mod" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="Install_Click"/>
     <TextBlock x:Name="InstalledModText" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <Border x:Name="ControlSection" Style="{StaticResource SectionCard}"><StackPanel Spacing="12">
    <TextBlock Text="03  ·  模组控制" FontSize="20" FontWeight="SemiBold"/>
    <Button Content="进入修改页面 →" Click="Control_Click"/>
   </StackPanel></Border>
   <TextBlock x:Name="ResultText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
   <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed"/>
  </StackPanel>
 </ScrollViewer>
 <ContentControl x:Name="ControlHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 </Grid>
</UserControl>
