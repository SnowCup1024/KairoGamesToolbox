<UserControl x:Class="KairosoftGameToolbox.Views.GameDetailsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:KairosoftGameToolbox.Services"
 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
 <ScrollViewer x:Name="DetailsScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SizeChanged="DetailsScroll_SizeChanged">
  <StackPanel x:Name="PageBody" Margin="28,20,28,28" Spacing="20" HorizontalAlignment="Center">
   <Button Click="Back_Click" Style="{StaticResource SubtleButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Back"/><TextBlock Text="{l:Text Key='返回游戏库'}"/></StackPanel></Button>
   <Border Style="{StaticResource SectionCard}">
    <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border CornerRadius="10" Background="{ThemeResource CoverGradientBrush}" Height="150"><Image x:Name="Cover" Stretch="UniformToFill"/></Border>
     <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
      <TextBlock Text="{l:Text Key='模组管理'}" Style="{StaticResource LabelStyle}" Foreground="{ThemeResource AccentBrush}"/>
      <TextBlock x:Name="GameTitle" Style="{StaticResource PageTitleStyle}"/>
      <TextBlock x:Name="GameStatus" Foreground="{ThemeResource TextSecondaryBrush}"/>
      <Button x:Name="LaunchButton" Content="{l:Text Key='启动游戏'}" Style="{StaticResource AccentButtonStyle}" Click="Launch_Click"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <ToggleButton x:Name="ManageTab" Content="{l:Text Key='游戏目录与模组状态'}" IsChecked="True" HorizontalAlignment="Stretch" Click="ManageTab_Click"/>
    <ToggleButton x:Name="ControlTab" Grid.Column="1" Content="{l:Text Key='模组控制'}" HorizontalAlignment="Stretch" Click="ControlTab_Click"/>
   </Grid>
   <StackPanel x:Name="ManagePane" Spacing="20">
    <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="12">
     <TextBlock Text="{l:Text Key='游戏目录'}" Style="{StaticResource SectionTitleStyle}"/>
     <TextBlock Text="{l:Text Key='自动填写已安装的 Steam 或已保存的非 Steam 目录，也可以重新选择。'}" Foreground="{ThemeResource TextSecondaryBrush}"/>
     <Grid x:Name="TargetRow" ColumnSpacing="8" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="TargetText" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center"/>
      <Button x:Name="RemoveGameButton" Grid.Column="1" Width="32" Height="32" Padding="0" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="{l:Text Key='移除非 Steam 游戏'}" AutomationProperties.Name="{l:Text Key='移除非 Steam 游戏'}" Click="RemoveGame_Click"><FontIcon Glyph="&#xE74D;" FontSize="16"/></Button>
     </Grid>
     <StackPanel x:Name="DirectoryButtons" Orientation="Horizontal" Spacing="12"><Button Content="{l:Text Key='选择非 Steam 游戏目录'}" Click="Folder_Click"/><Button x:Name="SteamButton" Content="{l:Text Key='使用 Steam 目录'}" Click="Steam_Click"/></StackPanel>
    </StackPanel></Border>
    <Border x:Name="ModSection" Style="{StaticResource SectionCard}"><StackPanel Spacing="12">
     <TextBlock Text="{l:Text Key='模组状态'}" Style="{StaticResource SectionTitleStyle}"/>
     <TextBlock x:Name="InstalledModText" Style="{StaticResource LabelStyle}"/>
     <StackPanel Orientation="Horizontal" Spacing="12">
      <Button x:Name="InstallButton" Content="{l:Text Key='安装 Mod'}" Style="{StaticResource AccentButtonStyle}" Click="Install_Click"/>
      <Button x:Name="RemoveModButton" Content="{l:Text Key='删除 Mod'}" Click="RemoveMod_Click"/>
     </StackPanel>
    </StackPanel></Border>
   </StackPanel>
   <StackPanel x:Name="ControlPane" Spacing="20" Visibility="Collapsed">
    <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="16">
     <Grid ColumnSpacing="16" RowSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{l:Text Key='模组控制'}" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
      <StackPanel x:Name="ConnectionHeader" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
       <TextBlock x:Name="ConnectionStatus" Text="{l:Text Key='未连接'}" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
       <Button x:Name="RefreshControlButton" Width="32" Height="32" Padding="0" BorderThickness="0" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="{l:Text Key='刷新连接状态'}" AutomationProperties.Name="{l:Text Key='刷新连接状态'}" Click="RefreshControl_Click"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
      </StackPanel>
     </Grid>
     <Grid x:Name="FeatureGrid" ColumnSpacing="16" RowSpacing="16" HorizontalAlignment="Stretch"/>
     <TextBlock x:Name="FeatureEmpty" Text="{l:Text Key='此游戏暂未提供修改项。'}" Foreground="{ThemeResource TextSecondaryBrush}"/>
     <TextBlock x:Name="ControlFeedback"/>
    </StackPanel></Border>
    <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="12">
     <TextBlock Text="{l:Text Key='运行日志'}" Style="{StaticResource SectionTitleStyle}"/>
     <ScrollViewer x:Name="LogScroll" Height="300" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="LogLines" Spacing="4"/></ScrollViewer>
    </StackPanel></Border>
   </StackPanel>
   <TextBlock x:Name="ResultText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
   <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
