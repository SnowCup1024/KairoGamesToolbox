<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="KairosoftGameToolbox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 自定义颜色按主题提供；ThemeResource 让设置切换和跟随系统在运行时生效。 -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="PageBackgroundColor">#F5F5F5</Color>
                    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
                    <Color x:Key="CardBorderColor">#E3E3E3</Color>
                    <Color x:Key="CardHoverBorderColor">#2E7D32</Color>
                    <Color x:Key="TextPrimaryColor">#1B1B1B</Color>
                    <Color x:Key="TextSecondaryColor">#757575</Color>
                    <Color x:Key="AccentColor">#2E7D32</Color>
                    <Color x:Key="InstalledDotColor">#43A047</Color>
                    <Color x:Key="OwnedDotColor">#D99A00</Color>
                    <Color x:Key="NotOwnedDotColor">#9E9E9E</Color>
                    <Color x:Key="CoverGradient1Color">#7CB342</Color>
                    <Color x:Key="CoverGradient2Color">#33691E</Color>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="PageBackgroundColor">#202020</Color>
                    <Color x:Key="CardBackgroundColor">#2B2B2B</Color>
                    <Color x:Key="CardBorderColor">#4A4A4A</Color>
                    <Color x:Key="CardHoverBorderColor">#81C784</Color>
                    <Color x:Key="TextPrimaryColor">#F5F5F5</Color>
                    <Color x:Key="TextSecondaryColor">#BDBDBD</Color>
                    <Color x:Key="AccentColor">#81C784</Color>
                    <Color x:Key="InstalledDotColor">#66BB6A</Color>
                    <Color x:Key="OwnedDotColor">#F2B01E</Color>
                    <Color x:Key="NotOwnedDotColor">#B0B0B0</Color>
                    <Color x:Key="CoverGradient1Color">#689F38</Color>
                    <Color x:Key="CoverGradient2Color">#33691E</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 这些画刷是动态主题资源，C# 创建的控件也可通过 Application.Resources 复用。 -->
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{ThemeResource PageBackgroundColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource CardBackgroundColor}" />
            <SolidColorBrush x:Key="CardBorderBrushStatic" Color="{ThemeResource CardBorderColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource AccentColor}" />
            <SolidColorBrush x:Key="InstalledDotBrush" Color="{ThemeResource InstalledDotColor}" />
            <SolidColorBrush x:Key="OwnedDotBrush" Color="{ThemeResource OwnedDotColor}" />
            <SolidColorBrush x:Key="NotOwnedDotBrush" Color="{ThemeResource NotOwnedDotColor}" />

            <LinearGradientBrush x:Key="CoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{ThemeResource CoverGradient1Color}" Offset="0" />
                <GradientStop Color="{ThemeResource CoverGradient2Color}" Offset="1" />
            </LinearGradientBrush>
            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="24"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
