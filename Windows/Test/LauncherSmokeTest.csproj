<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LauncherSmokeTest</AssemblyName>
    <RootNamespace>KairosoftGameToolbox.Test</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <Content Include="..\Launcher\Data\KairosoftGames.json" Link="Data\KairosoftGames.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Launcher\Data\Assets\Covers\*.jpg" Link="Data\Assets\Covers\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
