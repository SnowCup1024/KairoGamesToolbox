<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KairosoftGameToolbox.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:KairosoftGameToolbox.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KairosoftGameToolbox.Models"
    xmlns:controls="using:KairosoftGameToolbox.Controls"
    mc:Ignorable="d" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

    <UserControl.Resources>
        <DataTemplate x:Key="GameCardTemplate" x:DataType="models:KairoGame">
            <controls:GameCard
                GameClicked="Card_GameClicked"
                LaunchRequested="Card_LaunchRequested"
                SaveDirectoryRequested="Card_SaveDirectoryRequested"
                VerticalAlignment="Top"
                Margin="0,0,0,16" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
    <Grid x:Name="LibraryRoot" Padding="28,24,28,24" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：搜索 + 分类切换 -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <TextBox
                x:Name="SearchBox"
                PlaceholderText="{l:Text Key='搜索中文、英文、拼音或首字母…'}"
                CornerRadius="8"
                VerticalAlignment="Center"
                TextChanged="SearchBox_TextChanged" />
        </Grid>

        <!-- 三个独立区域：每个区域单独排序和自适应排布 -->
        <ScrollViewer
            x:Name="GridScroll"
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalContentAlignment="Stretch">
            <!-- 左侧额外留出悬浮放大安全区，右侧留白避免最后一张卡片贴住滚动条。 -->
            <StackPanel x:Name="SectionsPanel" Spacing="20" Margin="8,16,28,0" HorizontalAlignment="Stretch">
                <StackPanel x:Name="InstalledSection" Spacing="8" HorizontalAlignment="Stretch">
                    <Grid MinHeight="34" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="InstalledSectionTitle" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="1" Background="{ThemeResource CardBorderBrushStatic}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="{l:Text Key='添加非 Steam 游戏'}" Click="AddNonSteam_Click"/>
                    </Grid>
                    <ItemsRepeater x:Name="InstalledRepeater" HorizontalAlignment="Stretch" ItemTemplate="{StaticResource GameCardTemplate}">
                        <ItemsRepeater.Layout>
                            <!-- Fill 让完整行按实际 viewport 宽度填满，Start 保留最后一行自然左对齐。 -->
                            <UniformGridLayout MinItemWidth="216" MinItemHeight="380" MinRowSpacing="8" MinColumnSpacing="16" ItemsJustification="Start" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <StackPanel x:Name="NotInstalledSection" Spacing="8" HorizontalAlignment="Stretch">
                    <Grid MinHeight="34" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NotInstalledSectionTitle" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="1" Background="{ThemeResource CardBorderBrushStatic}" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsRepeater x:Name="NotInstalledRepeater" HorizontalAlignment="Stretch" ItemTemplate="{StaticResource GameCardTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="216" MinItemHeight="380" MinRowSpacing="8" MinColumnSpacing="16" ItemsJustification="Start" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <StackPanel x:Name="NotOwnedSection" Spacing="8" HorizontalAlignment="Stretch">
                    <Grid MinHeight="34" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NotOwnedSectionTitle" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="1" Background="{ThemeResource CardBorderBrushStatic}" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsRepeater x:Name="NotOwnedRepeater" HorizontalAlignment="Stretch" ItemTemplate="{StaticResource GameCardTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="216" MinItemHeight="380" MinRowSpacing="8" MinColumnSpacing="16" ItemsJustification="Start" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 空态 -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            Visibility="Collapsed"
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <FontIcon Glyph="&#xE7BA;" FontSize="40" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock
                x:Name="EmptyTitle"
                Text="{l:Text Key='未检测到开罗游戏'}"
                Foreground="{ThemeResource TextSecondaryBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="EmptyDescription"
                Text="{l:Text Key='请确认 Steam 已安装并登录'}"
                Foreground="{ThemeResource TextSecondaryBrush}"
                HorizontalAlignment="Center" />
            <Button Content="{l:Text Key='手动刷新'}" HorizontalAlignment="Center" CornerRadius="8" Click="Refresh_Click" />
        </StackPanel>

        <ProgressRing
            x:Name="BusyRing"
            Grid.Row="1"
            Width="40"
            Height="40"
            IsActive="False"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
    <ContentControl x:Name="DetailHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</UserControl>
