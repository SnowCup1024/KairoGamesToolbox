# Generated build, test, publish, and package output
.Build/

# .NET / WinUI fallback output
**/[Bb]in/
**/[Oo]bj/

# User-specific IDE state
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Local secrets, backups, and operating-system files
*.bak
*.local
*.user.json
[Tt]humbs.db
Desktop.ini

# Local commercial game copies and saves
.TestGames/

# Local environment secrets
.env
.env.*
!.env.example

# Local agent instructions
AGENTS.md

# Local-only Mod development (also when nested)
KairoMods/

# Local test dependencies and backups, at any depth
**/.TestGames/
**/.Backups/
**/.Downloads/
**/interop/

# Game-specific source and explicitly bundled payloads are tracked.
# Shared runtimes, commercial assemblies and generated packages never are.
/Mods/**/*.zip
/Mods/**/BepInEx/core/
/Mods/**/dotnet/
/Mods/**/GameAssembly.dll
/Mods/**/global-metadata.dat
/Mods/**/KairoGames.exe
/Mods/**/*.pdb
