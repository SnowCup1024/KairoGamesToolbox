<UserControl x:Class="KairosoftGameToolbox.Views.ModControlPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer HorizontalContentAlignment="Stretch">
  <StackPanel Margin="28" Spacing="20" MaxWidth="1000">
   <Button Content="← 返回游戏详情" Click="Back_Click"/>
   <TextBlock x:Name="Heading" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock x:Name="TargetLabel" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}"/>
   <Border Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <StackPanel Spacing="14">
     <TextBlock Text="游戏连接" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock x:Name="Status" Text="尚未连接" TextWrapping="Wrap"/>
     <Button Content="刷新连接状态" Click="Refresh_Click"/>
     <TextBlock Text="先启动游戏并进入存档，看到余额后再启用控制。不要在首页启用。模组需 0.0.4 或兼容版本。" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}"/>
     <TextBlock x:Name="Feedback" TextWrapping="Wrap" Visibility="Collapsed"/>
     <Button x:Name="ActivateButton" Content="我已进入存档 · 启用控制" Click="Activate_Click" IsEnabled="False"/>
    </StackPanel>
   </Border>
   <Border Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <StackPanel Spacing="12">
     <TextBlock Text="修改菜单" FontSize="20" FontWeight="SemiBold"/>
     <Grid ColumnSpacing="24">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="金钱反加" VerticalAlignment="Center" ToolTipService.ToolTip="将实际扣款转为等额增加，正常收入不变。"/>
      <ToggleSwitch x:Name="MoneySwitch" Grid.Column="1" OnContent="" OffContent="" AutomationProperties.Name="金钱反加" Toggled="Money_Toggled" IsEnabled="False"/>
     </Grid>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
