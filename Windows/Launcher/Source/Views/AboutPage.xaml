<UserControl x:Class="KairosoftGameToolbox.Views.AboutPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:KairosoftGameToolbox.Services"
 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
 <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
  <StackPanel x:Name="PageBody" HorizontalAlignment="Center" Spacing="20" Margin="28,20,28,32">
   <TextBlock Text="{l:Text Key='关于'}" Style="{StaticResource PageTitleStyle}"/>
   <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="12">
    <TextBlock Text="{l:Text Key='开罗游戏工具箱'}" Style="{StaticResource SectionTitleStyle}"/>
    <Button x:Name="VersionText" Click="VersionText_Click" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{ThemeResource TextSecondaryBrush}"/>
    <TextBlock Text="{l:Text Key='管理 Steam 与非 Steam 开罗游戏，提供内置游戏模组、共享运行组件下载与实时控制。'}"/>
   </StackPanel></Border>
   <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="12">
    <TextBlock Text="{l:Text Key='许可证'}" Style="{StaticResource SectionTitleStyle}"/>
    <TextBlock Text="{l:Text Key='本项目使用 GNU General Public License v3.0（GPL-3.0）发布。你可以查看、修改和再发布符合许可证要求的代码。'}"/>
    <Button Content="{l:Text Key='查看完整许可证'}" Click="ViewLicense_Click"/>
   </StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
