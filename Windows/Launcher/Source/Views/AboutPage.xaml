<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KairosoftGameToolbox.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{ThemeResource PageBackgroundBrush}">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="20" Margin="28,20,28,32">
            <TextBlock Text="关于" Style="{StaticResource TitleTextBlockStyle}" />

            <Border
                Padding="20"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrushStatic}"
                BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="开罗游戏工具箱" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock
                        Text="面向 Steam 正版开罗游戏的启动器与 MOD 框架。启动器只读取 Steam 和游戏信息，不改写游戏文件。"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="10">
                <TextBlock Text="许可证" FontSize="16" FontWeight="SemiBold" />
                <TextBlock
                    Text="本项目使用 GNU General Public License v3.0（GPL-3.0）发布。你可以查看、修改和再发布符合许可证要求的代码。"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextSecondaryBrush}" />
                <Button
                    Content="查看完整许可证"
                    HorizontalAlignment="Left"
                    CornerRadius="8"
                    Click="ViewLicense_Click" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
