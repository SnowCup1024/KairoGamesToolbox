<UserControl x:Class="KairosoftGameToolbox.Views.AboutPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
 <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
  <StackPanel x:Name="PageBody" HorizontalAlignment="Center" Spacing="20" Margin="28,20,28,32">
   <TextBlock Text="关于" Style="{StaticResource PageTitleStyle}"/>
   <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="12">
    <TextBlock Text="开罗游戏工具箱" Style="{StaticResource SectionTitleStyle}"/>
    <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextSecondaryBrush}"/>
    <TextBlock Text="管理 Steam 与非 Steam 开罗游戏，支持本地 Mod 校验、安装更新，以及已适配游戏的实时修改。模组独立发布，在线下载尚未开放。"/>
   </StackPanel></Border>
   <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="12">
    <TextBlock Text="许可证" Style="{StaticResource SectionTitleStyle}"/>
    <TextBlock Text="本项目使用 GNU General Public License v3.0（GPL-3.0）发布。你可以查看、修改和再发布符合许可证要求的代码。"/>
    <Button Content="查看完整许可证" Click="ViewLicense_Click"/>
   </StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
