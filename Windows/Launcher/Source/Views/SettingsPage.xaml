<UserControl x:Class="KairosoftGameToolbox.Views.SettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:KairosoftGameToolbox.Services"
 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
 <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
  <StackPanel x:Name="PageBody" HorizontalAlignment="Center" Spacing="20" Margin="28,20,28,32">
   <TextBlock Text="{l:Text Key='设置'}" Style="{StaticResource PageTitleStyle}"/>
   <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="12">
    <TextBlock Text="{l:Text Key='用户界面'}" Style="{StaticResource SectionTitleStyle}"/>
    <TextBlock Text="{l:Text Key='语言'}" Style="{StaticResource LabelStyle}"/>
    <ComboBox x:Name="LanguageCombo" AutomationProperties.Name="{l:Text Key='语言'}" SelectionChanged="Language_SelectionChanged">
     <ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="繁體中文" Tag="zh-TW"/>
     <ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="日本語" Tag="ja"/>
    </ComboBox>
    <TextBlock Text="{l:Text Key='主题'}" Style="{StaticResource LabelStyle}"/>
    <ComboBox x:Name="ThemeCombo" AutomationProperties.Name="{l:Text Key='主题'}" SelectionChanged="Theme_SelectionChanged">
     <ComboBoxItem Content="{l:Text Key='跟随系统'}" Tag="system"/>
     <ComboBoxItem Content="{l:Text Key='浅色'}" Tag="light"/>
     <ComboBoxItem Content="{l:Text Key='深色'}" Tag="dark"/>
    </ComboBox>
   </StackPanel></Border>
   <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="12">
    <TextBlock Text="{l:Text Key='Steam 相关'}" Style="{StaticResource SectionTitleStyle}"/>
    <TextBlock Text="{l:Text Key='Steam 安装路径'}" Style="{StaticResource LabelStyle}"/>
    <TextBox x:Name="SteamPathBox" AutomationProperties.Name="{l:Text Key='Steam 安装路径'}" PlaceholderText="{l:Text Key='自动检测，也可手动修改'}"/>
    <Button Content="{l:Text Key='保存并重新扫描'}" Style="{StaticResource AccentButtonStyle}" Click="SaveAndRescan_Click"/>
    <TextBlock Text="{l:Text Key='Steam 游玩记录（可选）'}" Style="{StaticResource LabelStyle}" Margin="0,12,0,0"/>
    <TextBlock Text="Steam Web API Key"/>
    <TextBox x:Name="ApiKeyBox" AutomationProperties.Name="Steam Web API Key" PlaceholderText="{l:Text Key='手动输入 API Key'}"
     GotFocus="ApiKeyBox_GotFocus" LostFocus="ApiKeyBox_LostFocus" TextChanged="ApiKeyBox_TextChanged"/>
    <StackPanel x:Name="ApiButtons" Orientation="Horizontal" Spacing="12">
     <Button x:Name="SaveApiKeyButton" LostFocus="ApiKeyBox_LostFocus" Content="{l:Text Key='保存并重新扫描'}" Style="{StaticResource AccentButtonStyle}" Click="SaveApiKeyAndRescan_Click"/>
     <Button Content="{l:Text Key='打开获取页面'}" Click="OpenApiKeyPage_Click"/>
    </StackPanel>
    <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="{l:Text Key='在 Steam 网页中登录并获取 API Key。保存后查询拥有状态、游玩时长与最近游玩时间；清空并保存即可关闭。SteamID 自动获取，网络或配置不可用不影响启动游戏。'}"/>
   </StackPanel></Border>
   <Button x:Name="VersionText" Click="VersionText_Click" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{ThemeResource TextSecondaryBrush}"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
