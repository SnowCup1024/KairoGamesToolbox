<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KairosoftGameToolbox.Controls.GameCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:KairosoftGameToolbox.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalContentAlignment="Stretch">

    <UserControl.Resources>
        <!-- 右键菜单：存档编辑保留为未实现占位，存档目录仅对可定位的已安装游戏启用。 -->
        <MenuFlyout x:Key="CardMenuFlyout" Opening="CardMenuFlyout_Opening">
            <MenuFlyoutItem Text="{l:Text Key='启动游戏'}" Click="MenuLaunch_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE768;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="{l:Text Key='Mod 与存档修改'}" Click="MenuMod_Click" />
            <MenuFlyoutItem Text="{l:Text Key='打开存档目录'}" Click="MenuOpenSaveDirectory_Click" />
        </MenuFlyout>

        <!-- hover 动画：放大 1.04x + 轻微上移 + 描边高亮，EaseOut -->
        <Storyboard x:Name="HoverInStoryboard">
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardTranslate" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ColorAnimation Storyboard.TargetName="CardBorderBrush" Storyboard.TargetProperty="Color"
                            To="{ThemeResource CardHoverBorderColor}" Duration="0:0:0.15">
                <ColorAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </ColorAnimation.EasingFunction>
            </ColorAnimation>
        </Storyboard>
        <Storyboard x:Name="HoverOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ColorAnimation Storyboard.TargetName="CardBorderBrush" Storyboard.TargetProperty="Color"
                            To="{ThemeResource CardBorderColor}" Duration="0:0:0.15">
                <ColorAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </ColorAnimation.EasingFunction>
            </ColorAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Border
        x:Name="RootBorder"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        Background="{ThemeResource CardBackgroundBrush}"
        BorderThickness="1"
        CornerRadius="12"
        ContextFlyout="{StaticResource CardMenuFlyout}"
        Tapped="RootBorder_Tapped"
        PointerEntered="RootBorder_PointerEntered"
        PointerExited="RootBorder_PointerExited">
        <Border.BorderBrush>
            <SolidColorBrush x:Name="CardBorderBrush" Color="{ThemeResource CardBorderColor}" />
        </Border.BorderBrush>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" CenterX="100" CenterY="175" />
                <TranslateTransform x:Name="CardTranslate" />
            </TransformGroup>
        </Border.RenderTransform>

        <StackPanel>
            <!-- 封面区 -->
            <Border
                x:Name="CoverBorder"
                Height="280"
                Margin="4,4,4,0"
                CornerRadius="10"
                Background="{ThemeResource CoverGradientBrush}">
                <Grid>
                    <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed" />
                    <Grid x:Name="Placeholder" Background="{ThemeResource CoverGradientBrush}">
                        <TextBlock
                            x:Name="PlaceholderChar"
                            FontSize="72"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                    <!-- 右下角状态徽标 -->
                    <Border
                        x:Name="InstalledBadge"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,8,8"
                        Padding="8,3"
                        CornerRadius="10"
                        Background="#CC000000">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse x:Name="BadgeDot" Width="8" Height="8" VerticalAlignment="Center" />
                            <TextBlock x:Name="BadgeText" FontSize="11" Foreground="White" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 固定信息区：无游玩记录时名称居中；有记录时名称 / 时长紧凑上下排列 -->
            <Grid x:Name="InfoPanel" Height="64" Margin="8,4,8,8">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="GameName"
                        FontSize="14"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />

                    <!-- 游玩时长 / 最近游玩（可选，静默隐藏） -->
                    <TextBlock
                        x:Name="PlaytimeText"
                        FontSize="12"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
